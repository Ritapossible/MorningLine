# Copy to .env and fill in. Never commit .env; it is git-ignored.
# The deployer key deploys and then has no power: the contracts have no owner functions.

# RPC endpoints. The public Base endpoints are rate-limited; use a CDP or Alchemy URL.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# Deployer. Needs a little Base Sepolia ETH (and Base ETH for mainnet).
DEPLOYER_PRIVATE_KEY=

# Contract verification on Basescan.
ETHERSCAN_API_KEY=
