# Copy to .env.local for development, or set these in the Vercel project.
# Defaults point at the demo deployment on Base Sepolia, so the app runs with none of them set.

# Which deployment the app talks to.
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_MORNINGLINE_ADDRESS=0xcae6005f50ada8c55e6785998aaeb22242aabdbe
NEXT_PUBLIC_LINE_ADDRESS=0x11bd55d6ef883cfd73e346034b6d90d84f2d1ff9
NEXT_PUBLIC_USDC_ADDRESS=0xb997cef9a60b8d6f2f3e9dbc42a769dd4fcc2632

# Labels the UI. A demo deployment has short days and worthless tokens, and says so.
NEXT_PUBLIC_IS_DEMO=true
NEXT_PUBLIC_USDC_IS_FAUCET=true

# The checker that new deals are opened against.
NEXT_PUBLIC_CHECKER_ADDRESS=0x84c85b69a52EA047C168cDcA87496C884531343C

# Optional. Privy sign-in (email, Google or a wallet, with an embedded wallet for anyone who has
# none). The App ID is public, not a secret: create an app at dashboard.privy.io, add this site's
# domain to its allowed origins, and paste the ID here. Unset, the app uses plain wallets.
NEXT_PUBLIC_PRIVY_APP_ID=

# Optional browser RPC. The public endpoint is used when this is unset.
NEXT_PUBLIC_RPC_URL=

# Server side only, used by /api/deal/[id]. It reads historical contract state to find the
# exact blocks a deal's events are in, so the RPC must serve historical state.
RPC_URL=https://sepolia.base.org
# Optional: any block at or before the deployment. Shortens the search for a deal's opening block.
NEXT_PUBLIC_START_BLOCK=54344003
