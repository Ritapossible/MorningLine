# Copy to .env. Never commit it; .env* is git-ignored.
# The checker key holds a little Base ETH for gas and nothing else.

RPC_URL=
CHECKER_PRIVATE_KEY=
MORNINGLINE_ADDRESS=
START_BLOCK=0

# Read-only public access is enough (5,000 requests per hour).
GITHUB_TOKEN=

# 32 bytes of hex. Keeps the per-day check minute unpredictable, so the
# maintainer cannot put the line up only when a check is due.
CHECK_SEED=

# Optional. Public endpoints cap eth_getLogs ranges; Base's public Sepolia endpoint allows 200.
POLL_INTERVAL_MS=600000
HEALTH_PORT=8080
LOG_CHUNK_BLOCKS=200
